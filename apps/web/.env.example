# Supabase — copy these to apps/web/.env.local with real values from
# Supabase Studio → Project Settings → API. Do NOT commit .env.local.

# Public (safe to ship to the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Read only from server
# components, route handlers, server actions, or middleware. If this
# leaks into the client bundle, anyone can bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
